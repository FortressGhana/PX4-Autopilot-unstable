#!/bin/sh
#
# UUV default parameters.
#
# NOTE: Script variables are declared/initialized/unset in the rcS script.
#

set VEHICLE_TYPE uuv

# MAV_TYPE_SUBMARINE 12
param set-default MAV_TYPE 12

# Set micro-dds-client to use ethernet and IP-address 192.168.0.4
param set-default UXRCE_DDS_AG_IP -1062731772

# Disable preflight disarm to not interfere with external launching
param set-default COM_DISARM_PRFLT -1
param set-default CBRK_SUPPLY_CHK 894281
param set-default COM_ARM_HFLT_CHK 0

#Missing params
param set-default CP_DIST -1.0

# Default to VIO fusion
param set-default ATT_EXT_HDG_M 1
param set-default EKF2_EV_CTRL 15
param set-default EKF2_EV_DELAY 60
param set-default EKF2_GPS_CTRL 0

# Height: use barometer (BAR100) for depth reference
param set-default EKF2_HGT_REF 0
param set-default EKF2_BARO_CTRL 0

param set-default EKF2_MAG_TYPE 5  # 5 = None (use external yaw)
param set-default EKF2_EV_NOISE_MD 0
param set-default EKF2_EVV_NOISE 0.05
param set-default EKF2_EVP_NOISE 0.05
param set-default EKF2_EVA_NOISE 0.05
param set-default EKF2_EVV_GATE  3.0
param set-default EKF2_EVP_GATE  3.0

param set-default EKF2_EV_POS_X 0.0      # X offset from IMU to external sensor
param set-default EKF2_EV_POS_Y 0.0      # Y offset
param set-default EKF2_EV_POS_Z 0.0      # Z offset

#set STAB mode to true
param set-default UUV_STAB_MODE 1

# disable joystick input
param set-default COM_RC_IN_MODE 4

# --- Attitude tuning ---
param set-default UUV_ROLL_P 6.0
param set-default UUV_ROLL_D 1.0
param set-default UUV_PITCH_P 8.0
param set-default UUV_PITCH_D 2.5
param set-default UUV_YAW_P 8.0
param set-default UUV_YAW_D 2.5
param set-default UUV_YAW_I 0.5
param set-default UUV_YAW_I_MAX 0.2

# --- Position tuning ---
param set-default UUV_GAIN_X_P 2.0
param set-default UUV_GAIN_X_D 0.5
param set-default UUV_GAIN_Y_P 1.5
param set-default UUV_GAIN_Y_D 0.4
param set-default UUV_GAIN_Z_P 2.0
param set-default UUV_GAIN_Z_D 0.5

# --- Position hold integrators ---
param set-default POSE_XY_I_EN 1
param set-default POSE_KI_XY 0.3
param set-default POSE_I_MAX_XY 0.2
param set-default POSE_Z_I_ENABLE 1
param set-default POSE_KI_Z 0.3
param set-default POSE_I_MAX_Z 0.2

# --- Surge-pitch feedforward ---
# Disabled: allocator handles R4/R5 pitch coupling directly via effectiveness matrix.
# Thrusters are above CG (PZ=-0.113), producing nose-down coupling. Feedforward
# would double this effect since it also applies nose-down correction.
param set-default UUV_SURGE_PFF 0

# --- Saturation ---
param set-default UUV_TORQUE_SAT 1.0
param set-default UUV_THRUST_SAT 1.0

# Pixhawk IMU position relative to COG (body FRD frame)
param set-default EKF2_IMU_POS_X -0.095
param set-default EKF2_IMU_POS_Y 0.005
param set-default EKF2_IMU_POS_Z -0.0251
